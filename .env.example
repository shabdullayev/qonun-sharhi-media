# Sayt manzili (sitemap, canonical va Open Graph uchun). Oxirida "/" bo‘lmasin.
NEXT_PUBLIC_SITE_URL=https://qonunsharhi.uz

# AI maslahat uchun Claude API kaliti. Bo‘sh qolsa, "Yuridik maslahat" bo‘limi o‘chiq turadi.
ANTHROPIC_API_KEY=

# Ixtiyoriy: javob beradigan model (standart: claude-sonnet-5-5; arzonroq variant: claude-haiku-5-5)
ANTHROPIC_MODEL=

# Ixtiyoriy: kontent fayli manzili (standart: GitHub’dagi `sayt` tarmog‘idagi data/content.json). Bo‘sh satr = faqat loyihadagi fayl.
# CONTENT_URL=
